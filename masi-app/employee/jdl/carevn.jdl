entity LeaveRequest{
    id UUID unique required,
    status LeaveRequestStatus required,
    fromDate LocalDate required,
    toDate LocalDate required,
    reason String,
    leaveRequestType LeaveType required,
    fileAttachment Blob
    leaveRequestDayType LeaveRequestDayType required,
    isActive Boolean required
}

enum LeaveRequestStatus{
    PENDING,
    APPROVED,
    REJECTED,
    CANCELLED
}

enum LeaveType{
    SICK_LEAVE,
    ANNUAL_LEAVE,
    MATERNITY_LEAVE,
    UNPAID_LEAVE
}

enum LeaveRequestDayType{
    FULL_DAY,
    HALF_DAY
}

