entity LeaveRequestReview {
    id UUID required unique,
    status ReviewStatus required,
    reason String,
    isActive Boolean required
    createdAt ZonedDateTime
    lastUpdated ZonedDateTime
}

enum ReviewStatus {
    APPROVED,
    REJECTED
    AWAITING_REVIEW
}

