    <!--
        Added the entity EmployeeProfile.
    -->
    <changeSet id="20240709105452-1" author="jhipster">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="employee_profile">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="employee_code" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="full_name" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="gender" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="workspace_id" type="${uuidType}">
                <constraints nullable="false" />
            </column>
            <column name="citizen_id" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="citizen_issue_date" type="date">
                <constraints nullable="true" />
            </column>
            <column name="citizen_issue_place" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="residence_address" type="varchar(255)">
