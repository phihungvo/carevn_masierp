    <!--
        Added the constraints for entity LeaveDay.
    -->
    <changeSet id="20240626035619-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="leave_request_id"
                                 baseTableName="leave_day"
                                 constraintName="fk_leave_day__leave_request_id"
