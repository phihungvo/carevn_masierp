<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity TimeKeepingViolation.
    -->
    <changeSet id="20240525045021-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="time_keeping_id"
                                 baseTableName="time_keeping_violation"
                                 constraintName="fk_time_keeping_violation__time_keeping_id"
                                 referencedColumnNames="id"
                                 referencedTableName="time_keeping"
                                 />

        <addForeignKeyConstraint baseColumnNames="employee_id"
                                 baseTableName="time_keeping_violation"
                                 constraintName="fk_time_keeping_violation__employee_id"
                                 referencedColumnNames="id"
                                 referencedTableName="employee"
                                 />

        <addForeignKeyConstraint baseColumnNames="explanation_id"
                                 baseTableName="time_keeping_violation"
                                 constraintName="fk_time_keeping_violation__explanation_id"
                                 referencedColumnNames="id"
                                 referencedTableName="time_keeping_explanation"
                                 />
    </changeSet>
</databaseChangeLog>
