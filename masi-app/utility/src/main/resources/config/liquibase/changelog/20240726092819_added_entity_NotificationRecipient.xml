<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity NotificationRecipient.
    -->
    <changeSet id="20240726092819-1" author="jhipster">
        <createTable tableName="notification_recipient">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="notification_id" type="${uuidType}">
                <constraints nullable="false" />
            </column>
            <column name="recipient_id" type="${uuidType}">
                <constraints nullable="false" />
            </column>
            <column name="read" type="boolean">
                <constraints nullable="false" />
            </column>
            <column name="read_at" type="${datetimeType}">
                <constraints nullable="true" />
            </column>
        </createTable>
        <dropDefaultValue tableName="notification_recipient" columnName="read_at" columnDataType="${datetimeType}"/>
    </changeSet>
</databaseChangeLog>
