<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity QualityIndex.
    -->
    <changeSet id="20240905023705-1" author="jhipster" failOnError="false">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="quality_index">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="value" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="order_id" type="${uuidType}">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
        <dropDefaultValue tableName="quality_index" columnName="created_at"
            columnDataType="${datetimeType}" />
<!--        <sql> alter table contract_material alter column protein_parameters type text using-->
<!--            protein_parameters::text; </sql>-->
    </changeSet>


</databaseChangeLog>
