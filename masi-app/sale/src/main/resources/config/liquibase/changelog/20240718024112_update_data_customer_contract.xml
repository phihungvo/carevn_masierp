<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <changeSet id="20240723162211" author="HoangDang">
        <dropNotNullConstraint    schemaName="public" tableName="customer" columnName="birthday" />

        <dropColumn tableName="contract" columnName="contract_valid"/>
        <addColumn tableName="contract">
            <column name="contract_valid_from" type="date">
            </column>
            <column name="contract_valid_to" type="date">
            </column>
            <column name="customer_id" type="${uuidType}">
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
