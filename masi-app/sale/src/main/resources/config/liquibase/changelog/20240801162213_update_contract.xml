<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <changeSet id="20240801162213" author="HoangDang">
        <validCheckSum>ANY</validCheckSum>
        <addColumn tableName="contract">
            <column name="delivery_term_from" type="date">
                <constraints nullable="true" />
            </column>
            <column name="delivery_term_to" type="date">
                <constraints nullable="true" />
            </column>
            <column name="pay_term" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="pay_condition" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="delivery_location" type="varchar(255)">
                <constraints nullable="true" />
            </column>

            <column name="company" type="varchar(255)" defaultValue="KIM_LONG">
                <constraints nullable="true" />
            </column>
            <column name="department" type="varchar(255)" defaultValue="">
                <constraints nullable="true" />
            </column>
        </addColumn>
        <sql> ALTER TABLE contract ALTER COLUMN contract_total TYPE decimal(15, 2) USING
            contract_total::decimal; </sql>
    </changeSet>
</databaseChangeLog>