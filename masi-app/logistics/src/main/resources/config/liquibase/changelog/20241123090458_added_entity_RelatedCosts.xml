<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity RelatedCosts.
    -->
    <changeSet id="20241123090458-1" author="jhipster">
        <createTable tableName="related_costs">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="invoice_id" type="${uuidType}">
                <constraints nullable="true" />
            </column>
            <column name="payment_method_id" type="${uuidType}">
                <constraints nullable="true" />
            </column>
            <column name="payment_method_code" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="payment_method_name" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="vat_id" type="${uuidType}">
                <constraints nullable="true" />
            </column>
            <column name="vat" type="double">
                <constraints nullable="true" />
            </column>
            <column name="vat_amount" type="decimal(21,2)">
                <constraints nullable="true" />
            </column>
            <column name="total_amount" type="decimal(21,2)">
                <constraints nullable="true" />
            </column>
            <column name="debt_days" type="double">
                <constraints nullable="true" />
            </column>
            <column name="note" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="is_deleted" type="boolean">
                <constraints nullable="true" />
            </column>
            <column name="created_at" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
            <column name="created_by" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="${datetimeType}">
                <constraints nullable="true" />
            </column>
            <column name="updated_by" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="deleted_at" type="${datetimeType}">
                <constraints nullable="true" />
            </column>
            <column name="deleted_by" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="company" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="department" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
        <dropDefaultValue tableName="related_costs" columnName="created_at" columnDataType="${datetimeType}"/>
        <dropDefaultValue tableName="related_costs" columnName="updated_at" columnDataType="${datetimeType}"/>
        <dropDefaultValue tableName="related_costs" columnName="deleted_at" columnDataType="${datetimeType}"/>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->

    <!--
        Load sample data generated with Faker.js
        - This data can be easily edited using a CSV editor (or even MS Excel) and
          is located in the 'src/main/resources/config/liquibase/fake-data' directory
        - By default this data is applied when running with the JHipster 'dev' profile.
          This can be customized by adding or removing 'faker' in the 'spring.liquibase.contexts'
          Spring Boot configuration key.
    -->
    <changeSet id="20241123090458-1-data" author="jhipster" context="faker">
        <loadData
                  file="config/liquibase/fake-data/related_costs.csv"
                  separator=";"
                  tableName="related_costs"
                  usePreparedStatements="true">
            <column name="id" type="${uuidType}"/>
            <column name="invoice_id" type="${uuidType}"/>
            <column name="payment_method_id" type="${uuidType}"/>
            <column name="payment_method_code" type="string"/>
            <column name="payment_method_name" type="string"/>
            <column name="vat_id" type="${uuidType}"/>
            <column name="vat" type="numeric"/>
            <column name="vat_amount" type="numeric"/>
            <column name="total_amount" type="numeric"/>
            <column name="debt_days" type="numeric"/>
            <column name="note" type="string"/>
            <column name="is_deleted" type="boolean"/>
            <column name="created_at" type="date"/>
            <column name="created_by" type="string"/>
            <column name="updated_at" type="date"/>
            <column name="updated_by" type="string"/>
            <column name="deleted_at" type="date"/>
            <column name="deleted_by" type="string"/>
            <column name="company" type="string"/>
            <column name="department" type="string"/>
            <!-- jhipster-needle-liquibase-add-loadcolumn - JHipster (and/or extensions) can add load columns here -->
        </loadData>
    </changeSet>
    <changeSet id="20241123090458-2" author="luc.luong">
        <sql>
            ALTER TABLE invoice_supplies ADD COLUMN IF NOT EXISTS note TEXT;
            ALTER TABLE invoice_supplies ADD COLUMN IF NOT EXISTS vat_id UUID;
        </sql>
    </changeSet>

    <changeSet id="20241123090458-3" author="luc.luong">
        <sql>
            ALTER TABLE invoice_supplies ADD COLUMN IF NOT EXISTS import_tax_percentage NUMERIC;
            ALTER TABLE invoice_supplies ADD COLUMN IF NOT EXISTS import_tax_amount NUMERIC;
        </sql>
    </changeSet>
    <changeSet id="20241123090458-4" author="luc.luong">
        <sql>
            ALTER TABLE incoming_invoice ADD COLUMN IF NOT EXISTS is_invoice BOOLEAN;
            ALTER TABLE incoming_invoice ADD COLUMN IF NOT EXISTS total_amount_after_vat NUMERIC;
        </sql>
    </changeSet>
    <changeSet id="20241123090458-5" author="luc.luong">
        <sql>
            ALTER TABLE invoice_supplies ADD COLUMN IF NOT EXISTS total_amount_import_stock NUMERIC;
            ALTER TABLE incoming_invoice ADD COLUMN IF NOT EXISTS total_amount_import_stock NUMERIC;
            ALTER TABLE incoming_invoice DROP COLUMN IF EXISTS total_amount;
            ALTER TABLE incoming_invoice ADD COLUMN IF NOT EXISTS total_amount NUMERIC;
            ALTER TABLE invoice_supplies DROP COLUMN IF EXISTS grand_total;
            ALTER TABLE invoice_supplies ADD COLUMN IF NOT EXISTS grand_total NUMERIC;
        </sql>
    </changeSet>

</databaseChangeLog>
