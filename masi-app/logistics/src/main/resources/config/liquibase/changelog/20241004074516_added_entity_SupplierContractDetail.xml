<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity SupplierContractDetail.
    -->
    <changeSet id="20241004074516-1" author="jhipster">
        <validCheckSum>any</validCheckSum>
        <createTable tableName="supplier_contract_detail">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="supply_item_id" type="${uuidType}">
                <constraints nullable="true" />
            </column>
            <column name="unit_id" type="${uuidType}">
                <constraints nullable="true" />
            </column>
            <column name="quantity" type="integer">
                <constraints nullable="true" />
            </column>
            <column name="note" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="supplier_contract_id" type="${uuidType}">
                <constraints nullable="false" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
    </changeSet>


</databaseChangeLog>
