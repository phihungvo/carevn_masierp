<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity TransactionType.
    -->
    <changeSet id="20241127085646-1" author="jhipster">
        <createTable tableName="transaction_type">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="attribute" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="is_deleted" type="boolean">
                <constraints nullable="true" />
            </column>
            <column name="created_at" type="${datetimeType}">
                <constraints nullable="true" />
            </column>
            <column name="created_by" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="updated_at" type="${datetimeType}">
                <constraints nullable="true" />
            </column>
            <column name="updated_by" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="deleted_at" type="${datetimeType}">
                <constraints nullable="true" />
            </column>
            <column name="deleted_by" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="company" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="department" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
        <dropDefaultValue tableName="transaction_type" columnName="created_at" columnDataType="${datetimeType}"/>
        <dropDefaultValue tableName="transaction_type" columnName="updated_at" columnDataType="${datetimeType}"/>
        <dropDefaultValue tableName="transaction_type" columnName="deleted_at" columnDataType="${datetimeType}"/>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->

    <!--
        Load sample data generated with Faker.js
        - This data can be easily edited using a CSV editor (or even MS Excel) and
          is located in the 'src/main/resources/config/liquibase/fake-data' directory
        - By default this data is applied when running with the JHipster 'dev' profile.
          This can be customized by adding or removing 'faker' in the 'spring.liquibase.contexts'
          Spring Boot configuration key.
    -->
    <changeSet id="20241127085646-1-data" author="jhipster" context="faker">
        <loadData
                  file="config/liquibase/fake-data/transaction_type.csv"
                  separator=";"
                  tableName="transaction_type"
                  usePreparedStatements="true">
            <column name="id" type="${uuidType}"/>
            <column name="code" type="string"/>
            <column name="attribute" type="string"/>
            <column name="name" type="string"/>
            <column name="is_deleted" type="boolean"/>
            <column name="created_at" type="date"/>
            <column name="created_by" type="string"/>
            <column name="updated_at" type="date"/>
            <column name="updated_by" type="string"/>
            <column name="deleted_at" type="date"/>
            <column name="deleted_by" type="string"/>
            <column name="company" type="string"/>
            <column name="department" type="string"/>
            <!-- jhipster-needle-liquibase-add-loadcolumn - JHipster (and/or extensions) can add load columns here -->
        </loadData>
    </changeSet>
    <changeSet id="20241127085646-3" author="luc.luong">
        <sql>
            ALTER TABLE supplier_contract ADD COLUMN delivery_est_date DATE;
        </sql>
    </changeSet>
    <changeSet id="20241127085646-4" author="luc.luong">
        <sql>
            -- For item_asset_transfer table
            ALTER TABLE item_asset_transfer
            ALTER COLUMN attribute TYPE jsonb USING attribute::jsonb;

-- For asset_transfer_details table
            ALTER TABLE asset_transfer_details
            ALTER COLUMN attribute TYPE jsonb USING attribute::jsonb;

        </sql>
    </changeSet>
    <changeSet id="20241127085646-5" author="Hoang Dang">
        <sql>

            ALTER TABLE asset_transfer_details
                DROP COLUMN IF EXISTS inventories_storage_id;

            ALTER TABLE asset_transfer_details
                ADD COLUMN IF NOT EXISTS inventories_storage_id UUID;

        </sql>
    </changeSet>

    <changeSet id="20241127085646-6" author="Hoang Dang">
        <sql>

            ALTER TABLE asset_transfer_details
                ADD COLUMN IF NOT EXISTS item_asset_transfer_id UUID;

        </sql>
    </changeSet>

    <changeSet id="20241127085646-7" author="Hoang Dang">
        <validCheckSum>ANY</validCheckSum>
        <sql>

            ALTER TABLE item_asset_transfer
                ADD COLUMN IF NOT EXISTS transaction_type_id UUID;

        </sql>
    </changeSet>
</databaseChangeLog>
