            </column>
            <column name="company" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="department" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
        <dropDefaultValue tableName="inventories" columnName="created_at" columnDataType="${datetimeType}"/>
        <dropDefaultValue tableName="inventories" columnName="updated_at" columnDataType="${datetimeType}"/>
        <dropDefaultValue tableName="inventories" columnName="deleted_at" columnDataType="${datetimeType}"/>
