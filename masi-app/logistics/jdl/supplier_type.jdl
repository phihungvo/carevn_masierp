entity SupplierType {
    id UUID
    code String required
    name String required
    description String
    isDeleted Boolean
    createdAt ZonedDateTime required
    createdBy String required
    updatedAt ZonedDateTime
    updatedBy String
    deletedAt ZonedDateTime
    deletedBy String
    company String
    department String
}

dto * with mapstruct
service * with serviceClass
paginate * with pagination
filter *
