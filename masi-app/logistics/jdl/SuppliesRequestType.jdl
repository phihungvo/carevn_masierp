entity SuppliesRequestType {
    id UUID,
    code String,
    name String,
    note String,
    attribute String,

    isDeleted Boolean,
    createdAt ZonedDateTime required
    createdBy String required
    updatedAt ZonedDateTime
    updatedBy String
    deletedAt ZonedDateTime
    deletedBy String
    company String
    department String
}


dto * with mapstruct
service * with serviceClass
paginate * with pagination
filter *
