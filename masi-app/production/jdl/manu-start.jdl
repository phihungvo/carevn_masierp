entity MetalDetectionChecklist {
	id UUID required unique
    checkDate LocalDate required,
    finProductNo String required,
    magnetBegin Boolean required,
    magnetBeginNote String
    magnetEnd Boolean required,
    magnetEndNote String
    screen4Begin Boolean required,
    screen4BeginNote String
    screen4End Boolean required,
    screen4EndNote String
    screen3Begin Boolean required,
    screen3BeginNote String
    screen3End Boolean required,
    screen3EndNote String
    checkedBy UUID required,
    auditedBy UUID required,
    note String,
    isActive Boolean required,
    createdAt ZonedDateTime
    lastUpdated ZonedDateTime,
}
