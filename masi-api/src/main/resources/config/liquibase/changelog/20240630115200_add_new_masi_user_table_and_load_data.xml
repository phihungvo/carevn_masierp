<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        JHipster core tables.
        The initial schema has the '00000000000001' id, so that it is over-written if we re-generate it.
    -->
    <changeSet id="20240630115200-1" author="truongdd">
        <createTable tableName="masi_user">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_name" type="varchar(50)">
                <constraints unique="true" nullable="false" uniqueConstraintName="ux_masi_user_name"/>
            </column>
            <column name="password_hash" type="varchar(60)"/>
            <column name="first_name" type="varchar(50)"/>
            <column name="last_name" type="varchar(50)"/>
            <column name="email" type="varchar(191)">
                <constraints unique="true" nullable="true" uniqueConstraintName="ux_masi_user_email"/>
            </column>
            <column name="image_url" type="varchar(256)"/>
            <column name="activated" type="boolean" valueBoolean="false">
                <constraints nullable="false" />
            </column>
            <column name="lang_key" type="varchar(10)"/>
            <column name="activation_key" type="varchar(20)"/>
            <column name="reset_key" type="varchar(20)"/>
            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp"/>
            <column name="reset_date" type="timestamp">
                <constraints nullable="true"/>
            </column>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
            <column name="is_super_admin" type="boolean" valueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="employee_id" type="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>

        <createTable tableName="masi_authority">
            <column name="name" type="varchar(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="masi_user_authority">
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="authority_name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey columnNames="user_id, authority_name" tableName="masi_user_authority"/>

        <addForeignKeyConstraint baseColumnNames="authority_name"
                                 baseTableName="masi_user_authority"
                                 constraintName="fk_authority_name"
                                 referencedColumnNames="name"
                                 referencedTableName="masi_authority"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="masi_user_authority"
                                 constraintName="fk_user_id"
                                 referencedColumnNames="id"
                                 referencedTableName="masi_user"/>

        <addNotNullConstraint   columnName="password_hash"
                                columnDataType="varchar(60)"
                                tableName="masi_user"/>
        <loadData
            file="config/liquibase/data/authority.csv"
            separator=";"
            tableName="masi_authority"
            usePreparedStatements="true">
            <column name="name" type="string"/>
        </loadData>
        <loadData
            file="config/liquibase/data/20240630115400_masi_user.csv"
            separator=";"
            tableName="masi_user"
            usePreparedStatements="true">
            <column name="id" type="uuid"/>
            <column name="activated" type="boolean"/>
            <column name="created_date" type="timestamp"/>
            <column name="employee_id" type="uuid"/>
        </loadData>
        <loadData
            file="config/liquibase/data/20240630115900_masi_user_authority.csv"
            separator=";"
            tableName="masi_user_authority"
            usePreparedStatements="true">
            <column name="user_id" type="uuid"/>
        </loadData>
        <dropDefaultValue tableName="masi_user" columnName="created_date" columnDataType="${datetimeType}"/>
    </changeSet>
</databaseChangeLog>
