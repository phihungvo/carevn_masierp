<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">


    <changeSet id="20240616094300-1" author="truongdd">
        <createTable tableName="masi_group_user">
            <column name="group_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="masi_group_user" columnNames="group_id, user_id"/>
        <addForeignKeyConstraint baseTableName="masi_group_user" baseColumnNames="group_id"
                                 referencedTableName="masi_group" referencedColumnNames="id"
                                 constraintName="fk_group_user_group_id"/>
        <addForeignKeyConstraint baseTableName="masi_group_user" baseColumnNames="user_id"
                                 referencedTableName="masi_user" referencedColumnNames="id"
                                 constraintName="fk_group_user_user_id"/>

        <loadData tableName="masi_group_user" file="config/liquibase/data/20240630130200_user_group.csv" separator=";" usePreparedStatements="true">
            <column name="group_id" type="uuid"/>
            <column name="user_id" type="uuid"/>
        </loadData>
    </changeSet>

</databaseChangeLog>
